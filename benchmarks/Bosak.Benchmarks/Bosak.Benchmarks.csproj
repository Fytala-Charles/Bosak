<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Bosak.Benchmarks</RootNamespace>
    <Description>BenchmarkDotNet harness for the Bosak XPath 3.1 / XSLT 3.0 / XQuery 3.1 engine. Not part of Bosak.sln; run manually from the repository root.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bosak.XPath.Api\Bosak.XPath.Api.csproj" />
    <ProjectReference Include="..\..\src\Bosak.XPath.Runtime\Bosak.XPath.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Bosak.XPath.Providers\Bosak.XPath.Providers.csproj" />
    <ProjectReference Include="..\..\src\Bosak.Xslt\Bosak.Xslt.csproj" />
    <ProjectReference Include="..\..\src\Bosak.XQuery\Bosak.XQuery.csproj" />
  </ItemGroup>

</Project>
