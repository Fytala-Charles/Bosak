From 0e3204d35a81f933cde0e01bd78f71d6cb17ff59 Mon Sep 17 00:00:00 2001
From: Charles Korthout <charles.korthout@fytala.nl>
Date: Wed, 14 Oct 2026 06:28:10 +0200
Subject: [PATCH] Correct native namespace expectations in fixed-namespaces
 tests

---
 .../fixed-namespaces/_fixed-namespaces-test-set.xml    | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/tests/attr/fixed-namespaces/_fixed-namespaces-test-set.xml b/tests/attr/fixed-namespaces/_fixed-namespaces-test-set.xml
index 07e12165..91c3e94c 100644
--- a/tests/attr/fixed-namespaces/_fixed-namespaces-test-set.xml
+++ b/tests/attr/fixed-namespaces/_fixed-namespaces-test-set.xml
@@ -165,7 +165,10 @@
          <initial-template name="main"/>
       </test>
       <result>
-         <assert-xml><![CDATA[<out><hit>fixed</hit></out>]]></assert-xml>
+         <all-of>
+            <assert-xml><![CDATA[<out><hit xmlns:p="urn:other">fixed</hit></out>]]></assert-xml>
+            <assert>namespace-uri-for-prefix('p', /out/hit) eq 'urn:other'</assert>
+         </all-of>
       </result>
    </test-case>
 
@@ -189,7 +192,10 @@
          <initial-template name="main"/>
       </test>
       <result>
-         <assert-xml><![CDATA[<out string="1" qname="1"/>]]></assert-xml>
+         <all-of>
+            <assert-xml><![CDATA[<out xmlns:p="urn:local" string="1" qname="1"/>]]></assert-xml>
+            <assert>namespace-uri-for-prefix('p', /out) eq 'urn:local'</assert>
+         </all-of>
       </result>
    </test-case>
 
-- 
2.54.0.windows.1

