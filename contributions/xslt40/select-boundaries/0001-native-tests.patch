From 5f3296d12cf7aa5ad76554ea95f95f990629e04f Mon Sep 17 00:00:00 2001
From: Charles Korthout <charles.korthout@fytala.nl>
Date: Mon, 12 Oct 2026 21:20:38 +0200
Subject: [PATCH] Add select focused boundary tests

---
 tests/misc/seqtor/_seqtor-test-set.xml | 16 +++++++++++++++-
 tests/misc/seqtor/seqtor-145.xsl       | 13 +++++++++++++
 tests/misc/seqtor/seqtor-146.xsl       |  9 +++++++++
 3 files changed, 37 insertions(+), 1 deletion(-)
 create mode 100644 tests/misc/seqtor/seqtor-145.xsl
 create mode 100644 tests/misc/seqtor/seqtor-146.xsl

diff --git a/tests/misc/seqtor/_seqtor-test-set.xml b/tests/misc/seqtor/_seqtor-test-set.xml
index 45fbe8b3..6eb21883 100644
--- a/tests/misc/seqtor/_seqtor-test-set.xml
+++ b/tests/misc/seqtor/_seqtor-test-set.xml
@@ -1,4 +1,4 @@
-﻿<?xml version="1.0" encoding="UTF-8"?>
+<?xml version="1.0" encoding="UTF-8"?>
 <test-set xmlns="http://www.w3.org/2012/10/xslt-test-catalog" xmlns:xs="http://www.w3.org/2001/XMLSchema" name="seqtor">
    <description>Tests constructing content in sequence constructors</description>
    
@@ -1241,4 +1241,18 @@
    </test-case>
 
 
+   <test-case name="seqtor-145">
+      <description>CDATA map expression preserves a literal newline and both quote characters under expand-text.</description>
+      <created by="Charles Korthout" on="2026-10-12"/>
+      <dependencies><spec value="XSLT40+"/></dependencies>
+      <test><stylesheet file="seqtor-145.xsl"/></test>
+      <result><assert-xml><![CDATA[<out small="true" length="3" newline="10" quotes="2"/>]]></assert-xml></result>
+   </test-case>
+   <test-case name="seqtor-146">
+      <description>Sequence-valued select body evaluates with the current item, position and size.</description>
+      <created by="Charles Korthout" on="2026-10-12"/>
+      <dependencies><spec value="XSLT40+"/></dependencies>
+      <test><stylesheet file="seqtor-146.xsl"/></test>
+      <result><assert-xml><![CDATA[<out><row value="A|1|3"/><row value="B|2|3"/><row value="C|3|3"/></out>]]></assert-xml></result>
+   </test-case>
 </test-set>
\ No newline at end of file
diff --git a/tests/misc/seqtor/seqtor-145.xsl b/tests/misc/seqtor/seqtor-145.xsl
new file mode 100644
index 00000000..43e91da0
--- /dev/null
+++ b/tests/misc/seqtor/seqtor-145.xsl
@@ -0,0 +1,13 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<xsl:stylesheet version="4.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
+ xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:order-types"
+ xmlns:map="http://www.w3.org/2005/xpath-functions/map" exclude-result-prefixes="#all">
+<!-- CDATA map expression preserves a literal newline and both quote characters under expand-text. -->
+<xsl:template name="xsl:initial-template">
+<xsl:variable name="m" as="map(*)"><xsl:select as="map(*)" expand-text="yes"><![CDATA[
+map{'small': 2 < 3, 'note': 'A
+B', 'quotes': concat("'", '"')}
+]]></xsl:select></xsl:variable>
+<out small="{$m?small}" length="{string-length($m?note)}" newline="{string-to-codepoints($m?note)[2]}" quotes="{string-length($m?quotes)}"/>
+</xsl:template>
+</xsl:stylesheet>
diff --git a/tests/misc/seqtor/seqtor-146.xsl b/tests/misc/seqtor/seqtor-146.xsl
new file mode 100644
index 00000000..ed123844
--- /dev/null
+++ b/tests/misc/seqtor/seqtor-146.xsl
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<xsl:stylesheet version="4.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
+ xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:order-types"
+ xmlns:map="http://www.w3.org/2005/xpath-functions/map" exclude-result-prefixes="#all">
+<!-- Sequence-valued select body evaluates with the current item, position and size. -->
+<xsl:template name="xsl:initial-template">
+<out><xsl:for-each select="('A','B','C')"><xsl:variable name="row" as="item()*"><xsl:select>(., position(), last())</xsl:select></xsl:variable><row value="{string-join($row ! string(.),'|')}"/></xsl:for-each></out>
+</xsl:template>
+</xsl:stylesheet>
-- 
