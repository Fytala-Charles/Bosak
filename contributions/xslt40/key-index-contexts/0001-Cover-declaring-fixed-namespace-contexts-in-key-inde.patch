From 586d75d77c62b82d7a455a8a6095a2c59199a337 Mon Sep 17 00:00:00 2001
From: Charles Korthout <charles.korthout@fytala.nl>
Date: Wed, 14 Oct 2026 08:19:05 +0200
Subject: [PATCH] Cover declaring fixed namespace contexts in key indexing

---
 .../_fixed-namespaces-test-set.xml            | 29 +++++++++++++++++++
 .../fixed-namespaces/fixed-namespaces-016.xsl | 21 ++++++++++++++
 .../fixed-namespaces-017-keys.xsl             |  6 ++++
 .../fixed-namespaces/fixed-namespaces-017.xsl | 15 ++++++++++
 4 files changed, 71 insertions(+)
 create mode 100644 tests/attr/fixed-namespaces/fixed-namespaces-016.xsl
 create mode 100644 tests/attr/fixed-namespaces/fixed-namespaces-017-keys.xsl
 create mode 100644 tests/attr/fixed-namespaces/fixed-namespaces-017.xsl

diff --git a/tests/attr/fixed-namespaces/_fixed-namespaces-test-set.xml b/tests/attr/fixed-namespaces/_fixed-namespaces-test-set.xml
index 07e12165..2e4b5797 100644
--- a/tests/attr/fixed-namespaces/_fixed-namespaces-test-set.xml
+++ b/tests/attr/fixed-namespaces/_fixed-namespaces-test-set.xml
@@ -193,6 +193,35 @@
       </result>
    </test-case>
 
+   <test-case name="fixed-namespaces-016">
+      <description>Key match QNames, wildcards and predicates use module fixed bindings despite native rebinding and a locally earlier version.</description>
+      <created by="Charles Korthout" on="2026-10-14"/>
+      <test>
+         <stylesheet file="fixed-namespaces-016.xsl"/>
+         <initial-template name="main"/>
+      </test>
+      <result>
+         <all-of>
+            <assert-xml><![CDATA[<out current="1" earlier="1" current-ns="urn:fixed" earlier-ns="urn:fixed"/>]]></assert-xml>
+            <assert>empty(namespace-uri-for-prefix('p', /out)) and empty(namespace-uri-for-prefix('q', /out))</assert>
+         </all-of>
+      </result>
+   </test-case>
+
+   <test-case name="fixed-namespaces-017">
+      <description>Key use expressions retain their included module's fixed bindings independently of caller bindings and local grammar.</description>
+      <created by="Charles Korthout" on="2026-10-14"/>
+      <test>
+         <stylesheet file="fixed-namespaces-017.xsl"/>
+         <initial-template name="main"/>
+      </test>
+      <result>
+         <all-of>
+            <assert-xml><![CDATA[<out current="1" earlier="1"/>]]></assert-xml>
+            <assert>empty(namespace-uri-for-prefix('p', /out)) and empty(namespace-uri-for-prefix('q', /out))</assert>
+         </all-of>
+      </result>
+   </test-case>
    <test-case name="fixed-namespaces-901">
       <description>xsl prefix used in xsl:initial-template but not declared</description>
       <created by="Michael Kay" on="2023-11-28"/>     
diff --git a/tests/attr/fixed-namespaces/fixed-namespaces-016.xsl b/tests/attr/fixed-namespaces/fixed-namespaces-016.xsl
new file mode 100644
index 00000000..112fd6c8
--- /dev/null
+++ b/tests/attr/fixed-namespaces/fixed-namespaces-016.xsl
@@ -0,0 +1,21 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<xsl:stylesheet version="4.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
+    xmlns:p="urn:native" exclude-result-prefixes="#all"
+    fixed-namespaces="#standard p=urn:fixed q=urn:fixed">
+  <xsl:key name="k4" match="p:item" use="@id"/>
+  <xsl:key version="3.0" xmlns:p="urn:local" name="k3"
+      match="q:*[@id = 'a']" use="@id"/>
+  <xsl:template name="main">
+    <xsl:variable name="doc">
+      <src:root xmlns:src="urn:fixed">
+        <src:item id="a"/>
+        <src:other id="b"/>
+        <native:item xmlns:native="urn:native" id="a"/>
+      </src:root>
+    </xsl:variable>
+    <out current="{count(key('k4', 'a', $doc))}"
+         earlier="{count(key('k3', 'a', $doc))}"
+         current-ns="{namespace-uri(key('k4', 'a', $doc)[1])}"
+         earlier-ns="{namespace-uri(key('k3', 'a', $doc)[1])}"/>
+  </xsl:template>
+</xsl:stylesheet>
diff --git a/tests/attr/fixed-namespaces/fixed-namespaces-017-keys.xsl b/tests/attr/fixed-namespaces/fixed-namespaces-017-keys.xsl
new file mode 100644
index 00000000..025f2bd2
--- /dev/null
+++ b/tests/attr/fixed-namespaces/fixed-namespaces-017-keys.xsl
@@ -0,0 +1,6 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<xsl:stylesheet version="4.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
+    xmlns:p="urn:native" fixed-namespaces="#standard p=urn:fixed q=urn:fixed">
+  <xsl:key name="u4" match="item" use="@p:id"/>
+  <xsl:key version="3.0" xmlns:p="urn:local" name="u3" match="item" use="@q:id"/>
+</xsl:stylesheet>
diff --git a/tests/attr/fixed-namespaces/fixed-namespaces-017.xsl b/tests/attr/fixed-namespaces/fixed-namespaces-017.xsl
new file mode 100644
index 00000000..0c916aee
--- /dev/null
+++ b/tests/attr/fixed-namespaces/fixed-namespaces-017.xsl
@@ -0,0 +1,15 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<xsl:stylesheet version="4.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
+    xmlns:p="urn:native" exclude-result-prefixes="#all"
+    fixed-namespaces="#standard p=urn:caller">
+  <xsl:include href="fixed-namespaces-017-keys.xsl"/>
+  <xsl:template name="main">
+    <xsl:variable name="doc">
+      <root xmlns:src="urn:fixed" xmlns:caller="urn:caller">
+        <item src:id="a" caller:id="wrong"/>
+      </root>
+    </xsl:variable>
+    <out current="{count(key('u4', 'a', $doc))}"
+         earlier="{count(key('u3', 'a', $doc))}"/>
+  </xsl:template>
+</xsl:stylesheet>
-- 
2.54.0.windows.1

