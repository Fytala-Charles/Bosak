<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <PackageId>Bosak.XPath.Standard</PackageId>
    <Description>Bosak: standard XPath 3.1 / XQuery 3.1 function library — fn:*, math:*, map:*, array:* and JSON functions. Part of the Bosak XPath 3.1 / XSLT 3.0 / XQuery 3.1 stack for .NET.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bosak.XPath.Core\Bosak.XPath.Core.csproj" />
    <ProjectReference Include="..\Bosak.XPath.Providers\Bosak.XPath.Providers.csproj" />
    <ProjectReference Include="..\Bosak.XPath.Runtime\Bosak.XPath.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\schema-for-json.xsd" />
    <EmbeddedResource Include="Resources\analyze-string.xsd" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bosak.XQuery" />
  </ItemGroup>

</Project>
