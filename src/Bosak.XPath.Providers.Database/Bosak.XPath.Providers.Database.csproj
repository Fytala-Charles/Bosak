<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <PackageId>Bosak.XPath.Providers.Database</PackageId>
    <Description>Bosak: XML database REST document loaders — resolve basex://, exist://, and marklogic:// URIs through the Bosak XPath 3.1 / XSLT 3.0 / XQuery 3.1 engine's DocumentLoader hooks (BaseX / eXist / MarkLogic REST endpoints, in-memory and forward-only streaming loads).</Description>
    <!-- REQ-120: the owner registered Bosak.XPath.Providers.Database on nuget.org for Trusted
         Publishing (2026-10-03), so the package ships with the next core tag. release.yml packs
         the whole solution (dotnet pack Bosak.sln) and pushes every nupkg except LanguageServer
         with skip-duplicate, making re-runs safe. Keep this true; flip back only if the
         nuget.org registration is removed. -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bosak.XPath.Core\Bosak.XPath.Core.csproj" />
    <ProjectReference Include="..\Bosak.XPath.Providers\Bosak.XPath.Providers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bosak.XPath.Providers.Database.Tests" />
  </ItemGroup>

</Project>
