<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <PackageId>Bosak.XPath.Runtime</PackageId>
    <Description>Bosak: register-based virtual machine that executes compiled XPath 3.1 / XSLT 3.0 / XQuery 3.1 programs. Runtime layer of the Bosak stack for .NET.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bosak.XPath.Core\Bosak.XPath.Core.csproj" />
    <ProjectReference Include="..\Bosak.XPath.Compiler\Bosak.XPath.Compiler.csproj" />
    <ProjectReference Include="..\Bosak.XPath.Providers\Bosak.XPath.Providers.csproj" />
  </ItemGroup>

</Project>
