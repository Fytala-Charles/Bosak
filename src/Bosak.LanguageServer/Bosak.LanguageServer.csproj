<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Bosak.LanguageServer</PackageId>
    <Description>Language Server Protocol implementation for XPath 3.1 and XSLT 3.0</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bosak.LanguageServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OmniSharp.Extensions.LanguageServer" Version="0.19.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bosak.XPath.Parser\Bosak.XPath.Parser.csproj" />
    <ProjectReference Include="..\Bosak.XPath.Compiler\Bosak.XPath.Compiler.csproj" />
    <ProjectReference Include="..\Bosak.Xslt\Bosak.Xslt.csproj" />
    <ProjectReference Include="..\Bosak.XPath.Api\Bosak.XPath.Api.csproj" />
    <ProjectReference Include="..\Bosak.XPath.Core\Bosak.XPath.Core.csproj" />
  </ItemGroup>

</Project>
