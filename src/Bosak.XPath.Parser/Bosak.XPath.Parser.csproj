<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <PackageId>Bosak.XPath.Parser</PackageId>
    <Description>Bosak: hand-written recursive-descent parser for XPath 3.1 / XQuery 3.1 expressions. Parser layer of the Bosak stack for .NET.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bosak.XPath.Core\Bosak.XPath.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bosak.XPath.Compiler" />
    <InternalsVisibleTo Include="Bosak.XPath.Runtime" />
    <InternalsVisibleTo Include="Bosak.XPath.Api" />
    <InternalsVisibleTo Include="Bosak.Xslt" />
    <InternalsVisibleTo Include="Bosak.XQuery" />
    <InternalsVisibleTo Include="Bosak.LanguageServer" />
    <InternalsVisibleTo Include="Bosak.XPath.Parser.Tests" />
    <InternalsVisibleTo Include="Bosak.XPath.Compiler.Tests" />
    <InternalsVisibleTo Include="Bosak.XPath.Runtime.Tests" />
    <InternalsVisibleTo Include="Bosak.XQuery.Tests" />
  </ItemGroup>

</Project>
