{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XSLT",
  "scopeName": "text.xml.xsl",
  "fileTypes": [
    "xsl",
    "xslt"
  ],
  "patterns": [
    {
      "name": "comment.block.xml",
      "begin": "<!--",
      "end": "-->"
    },
    {
      "name": "string.unquoted.cdata.xml",
      "begin": "<!\\[CDATA\\[",
      "end": "\\]\\]>"
    },
    {
      "name": "meta.tag.preprocessor.xml",
      "begin": "<\\?",
      "end": "\\?>"
    },
    {
      "include": "#xslt-instruction"
    },
    {
      "include": "#xml-tag"
    },
    {
      "include": "text.xml"
    }
  ],
  "repository": {
    "entity": {
      "name": "constant.character.entity.xml",
      "match": "&(?:#[0-9]+|#x[0-9a-fA-F]+|[\\w:.-]+);"
    },
    "xpath-attribute": {
      "patterns": [
        {
          "name": "meta.attribute.xpath.xslt",
          "begin": "(?<![\\w:.-])(select|test|match|use|use-when|count|from|group-by|group-adjacent|group-starting-with|group-ending-with|initial-value|for-each-source|context-item|as)(\\s*=\\s*)(\")",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.xml"
            },
            "2": {
              "name": "punctuation.separator.key-value.xml"
            },
            "3": {
              "name": "punctuation.definition.string.begin.xml"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.xml"
            }
          },
          "contentName": "meta.embedded.block.xpath",
          "patterns": [
            {
              "include": "source.xpath"
            }
          ]
        },
        {
          "name": "meta.attribute.xpath.xslt",
          "begin": "(?<![\\w:.-])(select|test|match|use|use-when|count|from|group-by|group-adjacent|group-starting-with|group-ending-with|initial-value|for-each-source|context-item|as)(\\s*=\\s*)(')",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.xml"
            },
            "2": {
              "name": "punctuation.separator.key-value.xml"
            },
            "3": {
              "name": "punctuation.definition.string.begin.xml"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.xml"
            }
          },
          "contentName": "meta.embedded.block.xpath",
          "patterns": [
            {
              "include": "source.xpath"
            }
          ]
        }
      ]
    },
    "attribute": {
      "patterns": [
        {
          "name": "meta.attribute.xml",
          "begin": "(?<![\\w:.-])([\\w:.-]+)(\\s*=\\s*)(\")",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.xml"
            },
            "2": {
              "name": "punctuation.separator.key-value.xml"
            },
            "3": {
              "name": "punctuation.definition.string.begin.xml"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.xml"
            }
          },
          "contentName": "string.quoted.double.xml",
          "patterns": [
            {
              "include": "#entity"
            }
          ]
        },
        {
          "name": "meta.attribute.xml",
          "begin": "(?<![\\w:.-])([\\w:.-]+)(\\s*=\\s*)(')",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.xml"
            },
            "2": {
              "name": "punctuation.separator.key-value.xml"
            },
            "3": {
              "name": "punctuation.definition.string.begin.xml"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.xml"
            }
          },
          "contentName": "string.quoted.single.xml",
          "patterns": [
            {
              "include": "#entity"
            }
          ]
        }
      ]
    },
    "xslt-instruction": {
      "begin": "(<)(/?)(xsl:[\\w.-]+)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.xml"
        },
        "2": {
          "name": "punctuation.definition.tag.begin.xml"
        },
        "3": {
          "name": "entity.name.tag.xml"
        }
      },
      "end": "/?>",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.tag.end.xml"
        }
      },
      "patterns": [
        {
          "include": "#xpath-attribute"
        },
        {
          "include": "#attribute"
        }
      ]
    },
    "xml-tag": {
      "begin": "(<)(/?)([\\w:.-]+)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.xml"
        },
        "2": {
          "name": "punctuation.definition.tag.begin.xml"
        },
        "3": {
          "name": "entity.name.tag.xml"
        }
      },
      "end": "/?>",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.tag.end.xml"
        }
      },
      "patterns": [
        {
          "include": "#attribute"
        }
      ]
    }
  }
}
