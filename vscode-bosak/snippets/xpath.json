{
  "Conditional": {
    "prefix": "bosak-if",
    "description": "XPath conditional expression",
    "body": [
      "if (${1:true()}) then ${2:1} else ${3:0}$0"
    ]
  },
  "For expression": {
    "prefix": "bosak-for",
    "description": "XPath for expression",
    "body": [
      "for \\$${1:item} in (${2:1, 2, 3}) return \\$$1$0"
    ]
  },
  "Let expression": {
    "prefix": "bosak-let",
    "description": "XPath let expression",
    "body": [
      "let \\$${1:value} := ${2:1} return \\$$1$0"
    ]
  },
  "Map": {
    "prefix": "bosak-map",
    "description": "XPath 3.1 map constructor",
    "body": [
      "map { '${1:key}': ${2:1} }$0"
    ]
  },
  "Array": {
    "prefix": "bosak-array",
    "description": "XPath 3.1 square array constructor",
    "body": [
      "[${1:1, 2, 3}]$0"
    ]
  }
}
