string-join(for $line in parse-xml('<deliveries><line id="B" quantity="5" price="4.00" date="2026-10-13" active="false"/><line id="A" quantity="12" price="2.50" date="2026-10-12" active="true"/></deliveries>')/deliveries/line return concat($line/@id, '|', $line/@quantity ! xs:integer(), '|', $line/@price ! xs:decimal(), '|', $line/@date ! xs:date(), '|', $line/@active ! xs:boolean()), ';')
