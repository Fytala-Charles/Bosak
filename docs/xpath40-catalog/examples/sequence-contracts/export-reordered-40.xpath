let $queue := parse-xml('<dispatch><order id="ORD-105"/><order id="ORD-104"/><order id="ORD-103"/><order id="ORD-102"/><order id="ORD-101"/></dispatch>')/dispatch/order/@id ! string(.) return let $page := slice($queue,2,4) return concat('page=',string-join($page,','),';last=',foot($page),';body=',string-join(trunk($page),','),';labels=',string-join(insert-separator(replicate($page,2),'|'),''),';requested=',string-join(items-at($queue,(5,2,2)),','))
