let $queue := parse-xml('<dispatch/>')/dispatch/order/@id ! string(.) return let $page := subsequence($queue,2,3) return concat('page=',string-join($page,','),';last=',$page[last()],';body=',string-join($page[position() lt last()],','),';labels=',string-join((for $station in 1 to 2 return $page),'|'),';requested=',string-join((for $position in (5,2,2) return $queue[$position]),','))
