let $parts := parse-xml('<catalog><part id="KIT"><needs ref="MISSING"/><needs ref="MOTOR"/></part><part id="BOLT"/><part id="FRAME"><needs ref="BOLT"/></part><part id="MOTOR"><needs ref="BOLT"/></part></catalog>')/catalog/part
return let $start := $parts[@id eq 'KIT']
return let $step := function($part) { $parts[@id = $part/needs/@ref] }
return count($parts/needs[not(@ref = $parts/@id)])
