<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:p="urn:fytala:module-profile" xmlns:o="urn:fytala:dispatch" exclude-result-prefixes="xs p o" version="3.0"><xsl:use-package name="urn:fytala:module-profile:package:report-baseline" package-version="1.0"/><xsl:output method="text"/><xsl:template match="/"><xsl:variable name="lines" select="o:orders/o:line"/><xsl:for-each select="$lines"><xsl:value-of select="concat(@id, '=', p:quantity(.), '|')"/></xsl:for-each><xsl:value-of select="concat('lines=',count($lines),';total=',sum($lines ! p:quantity(.)))"/></xsl:template></xsl:stylesheet>
