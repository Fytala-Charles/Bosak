<xsl:stylesheet version="3.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:o="urn:fytala:dispatch" exclude-result-prefixes="xs o"><xsl:output method="text"/><xsl:template match="/"><xsl:variable name="lines" select="o:orders/o:line"/><xsl:for-each select="$lines"><xsl:value-of select="concat(@id, '=', (if (@qty) then xs:integer(@qty) else 1), '|')"/></xsl:for-each><xsl:value-of select="concat('lines=', count($lines), ';total=', sum($lines ! (if (@qty) then xs:integer(@qty) else 1)))"/></xsl:template></xsl:stylesheet>
