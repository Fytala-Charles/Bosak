<xsl:stylesheet version="3.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:o="urn:fytala:dispatch" exclude-result-prefixes="xs o"><xsl:output method="text"/><xsl:template match="/" version="4.0"><xsl:variable name="lines" select="o:orders/o:line"/><xsl:for-each select="$lines"><xsl:value-of select="concat(@id, '=', ((xs:integer(@qty) ?? 1)), '|')"/></xsl:for-each><xsl:value-of select="concat('lines=', count($lines), ';total=', sum($lines ! ((xs:integer(@qty) ?? 1))))"/></xsl:template></xsl:stylesheet>
