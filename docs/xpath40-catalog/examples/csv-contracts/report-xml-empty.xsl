<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xs="http://www.w3.org/2001/XMLSchema" version="4.0"><xsl:output method="text"/><xsl:template match="/"><xsl:variable name="rows" select="for $row in csv-to-xml(unparsed-text(resolve-uri(&#x27;empty.csv&#x27;, static-base-uri())),map {&#x27;header&#x27;:true()})/*:csv/*:rows/*:row return array {$row/*:field/string()}"/><xsl:value-of select="string-join((for $row in $rows return $row?1 || &#x27;=&#x27; || string(xs:integer($row?2)), &#x27;lines=&#x27; || count($rows) || &#x27;;total=&#x27; || sum(for $row in $rows return xs:integer($row?2))), &#x27;|&#x27;)"/></xsl:template></xsl:stylesheet>
