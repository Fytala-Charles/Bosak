let $events := (map{'code':'packed','at':'09:00'},map{'code':'dispatched','at':'09:15'}), $required := (map{'code':'PACKED'},map{'code':'DISPATCHED'}), $same := function($event,$requirement){upper-case($event?code) eq $requirement?code} return concat(contains-subsequence($events,$required), '/', contains-subsequence($events,$required,$same), '/', starts-with-subsequence($events,$required,$same), '/', ends-with-subsequence($events,$required,$same))
