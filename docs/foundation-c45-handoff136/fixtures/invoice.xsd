<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" version="1.1"><xs:element name="invoice"><xs:complexType><xs:sequence>
<xs:element name="amount" type="xs:decimal" minOccurs="1" maxOccurs="2"/><xs:element name="tax" type="xs:decimal" minOccurs="0"/>
</xs:sequence><xs:assert test="count(amount) eq 2 and empty(tax)"/></xs:complexType></xs:element></xs:schema>
